{
    "configurations": [
        {
            "name": "Linux",
            "includePath": [
                "${workspaceFolder}/**",
                "${IDF_PATH}/components/**",
                "${XTENSA_ESP32_ELF_PATH}/xtensa-esp32-elf/**"
            ],
            "defines": [
                "ESP32",
                "FREERTOS"
