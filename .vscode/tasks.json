{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "shell",
            "problemMatcher": "$gcc",
            "command": "cmake --build ${workspaceFolder}/build"
        },
        {
            "label": "flash",
            "type": "shell",
            "problemMatcher": "$gcc",
            "command": "cmake --build ${workspaceFolder}/build --target flash"
        },
        {
            "label": "monitor",
            "type": "shell",
            "command": "idf.py monitor",
            "problemMatcher": []
        },
        {
            "label": "menuconfig",
            "type": "shell",
            "command": "idf.py -B ${workspaceFolder}/build menuconfig",
            "problemMatcher": []
        },
        {
            "label": "clean",
            "type": "shell",
            "problemMatcher": "$gcc",
            "command": "cmake --build ${workspaceFolder}/build --target clean"
        }
    ]
}