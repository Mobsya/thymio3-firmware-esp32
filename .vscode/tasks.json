        {
            "label": "thymio3-firmware-esp32: 1. Init/Update recursively git submodules",
            "type": "shell",
            "problemMatcher": "$gcc",
            "command": "git submodule update --init --recursive"
        },
        {
            "label": "thymio3-firmware-esp32: 2. Build MicroPython cross-compiler",
            "type": "shell",
            "problemMatcher": "$gcc",
            "command": "make V=1 -C mpy-cross",
            // "command": "clang --version",
            "options": {
                "cwd": "${workspaceFolder}/components/mp_component/micropython",
                // "windows": {
                //     "shell": {
                //         "executable": "cmd.exe",
                //         "args": ["/d", "/C"]
                //     }
                // },
            },
        },
        {
            "label": "thymio3-firmware-esp32: 3. Make ESP32 MicroPython submodules",
            "type": "shell",
            "problemMatcher": "$gcc",
            "command": "make submodules",
            // "command": "clang --version",
            "options": {
                "cwd": "${workspaceFolder}/components/mp_component/micropython/ports/esp32",
                // "windows": {
                //     "shell": {
                //         "executable": "cmd.exe",
                //         "args": ["/d", "/C"]
                //     }
                // },
            },
        },  
        {
            "label": "thymio3-firmware-esp32: 4. Make FULL ESP32 firmware",
            "type": "shell",
            "problemMatcher": "$gcc",
            "command": "/Users/danielburnier/.espressif/python_env/idf4.4_py3.11_env/bin/python ../esp/esp-adf/esp-idf/components/esptool_py/esptool/esptool.py --chip esp32  merge_bin 0x1000 build/bootloader/bootloader.bin 0x8000 build/partition_table/partition-table.bin 0xd000 build/ota_data_initial.bin 0x10000 build/thymio3-esp32-firmware.bin 0x680000 main/audio/audio_tone.bin -o build/FULL-ESP32-Test.bin",
